#!/usr/bin/env bash
# nvo — orquestrador local de agentes Claude Code.
# Cada agente roda em um git worktree isolado, em uma branch agent/<nome>,
# dentro de uma janela da sessao tmux "orquestra".

set -euo pipefail

ORQ="$HOME/orquestra"
# shellcheck source=platform.sh
[ -f "$ORQ/bin/platform.sh" ] && . "$ORQ/bin/platform.sh" || {
  ORQ_OS="desconhecido"; ORQ_PKG="none"; ORQ_HAS_APP=0
  ORQ_SHELL_RC="$HOME/.profile"
  orq_pkg_hint() { echo "instale '$1' pelo gerenciador de pacotes do seu sistema"; }
}
WT_ROOT="$ORQ/worktrees"
NOTES_ROOT="$ORQ/notes"
META_ROOT="$ORQ/agents"
CONF="$ORQ/project.conf"
SESSION="orquestra"

# O nvo pode ser chamado pelo app (launchd), que herda um PATH minimo sem
# homebrew e sem ~/.local/bin. Como o tmux congela o PATH de quando o servidor
# subiu, um agente lancado nesse estado nao acha o "claude" e falha calado.
# Garantimos os diretorios usuais aqui, sem duplicar o que ja esta no PATH.
for d in "$ORQ/bin" "$HOME/.local/bin" "$HOME/bin" /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in *":$d:"*) ;; *) [ -d "$d" ] && PATH="$d:$PATH" ;; esac
done
export PATH

# --- Limites da hierarquia -------------------------------------------------
# Um agente pode delegar criando subagentes, mas arvore de agente cresce em
# custo e cai em supervisao muito rapido. Os padroes abaixo sao o ponto onde
# delegacao ainda ajuda mais do que atrapalha. Precedencia:
#   variavel de ambiente  >  config.conf  >  padrao daqui
CONFIG="$ORQ/config.conf"

config_get() {
  local chave="$1" padrao="$2" valor=""
  [ -f "$CONFIG" ] && valor="$(sed -n "s/^$chave=//p" "$CONFIG" | tail -1)"
  printf '%s' "${valor:-$padrao}"
}

NVO_MAX_DEPTH="${NVO_MAX_DEPTH:-$(config_get max_depth 2)}"
NVO_MAX_FANOUT="${NVO_MAX_FANOUT:-$(config_get max_fanout 4)}"
NVO_MAX_AGENTS="${NVO_MAX_AGENTS:-$(config_get max_agents 12)}"

# faixa aceita por chave: min, max e a explicacao que o app mostra
config_spec() {
  case "$1" in
    max_depth)  echo "1|4|camadas de delegação|Quantos níveis abaixo do maestro. Cada camada afasta o trabalho de quem pediu: acima de 3 o pedido chega distorcido, porque cada nível reescreve a tarefa com as próprias palavras." ;;
    max_fanout) echo "1|8|subagentes por agente|Quantos filhos cada agente pode criar. Acima de 4 o pai gasta mais token coordenando do que o trabalho economiza." ;;
    max_agents) echo "1|24|agentes vivos ao mesmo tempo|Teto somando todas as camadas. Cada agente ativo consome contexto e janela de uso — 12 é confortável no plano Max; acima de 16 a janela de 5h costuma estourar." ;;
    *) return 1 ;;
  esac
}

# nvo config                  lista chave, valor, min, max, rotulo e explicacao
# nvo config <chave> <valor>  grava, validando a faixa
cmd_config() {
  local chave valor spec min max rotulo ajuda
  if [ $# -eq 0 ]; then
    for chave in max_depth max_fanout max_agents; do
      spec="$(config_spec "$chave")"
      IFS='|' read -r min max rotulo ajuda <<EOF
$spec
EOF
      case "$chave" in
        max_depth)  valor="$NVO_MAX_DEPTH" ;;
        max_fanout) valor="$NVO_MAX_FANOUT" ;;
        max_agents) valor="$NVO_MAX_AGENTS" ;;
      esac
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$chave" "$valor" "$min" "$max" "$rotulo" "$ajuda"
    done
    return 0
  fi

  [ $# -eq 2 ] || die "uso: nvo config [<chave> <valor>]"
  chave="$1"; valor="$2"
  spec="$(config_spec "$chave")" || die "chave desconhecida '$chave' (use: max_depth, max_fanout, max_agents)"
  IFS='|' read -r min max rotulo ajuda <<EOF
$spec
EOF
  printf '%s' "$valor" | grep -Eq '^[0-9]+$' || die "'$valor' nao e um numero inteiro"
  [ "$valor" -ge "$min" ] && [ "$valor" -le "$max" ] \
    || die "$chave aceita de $min a $max (recebi $valor)"

  touch "$CONFIG"
  if grep -q "^$chave=" "$CONFIG" 2>/dev/null; then
    # sed -i portatil entre BSD e GNU: reescreve num temporario
    sed "s/^$chave=.*/$chave=$valor/" "$CONFIG" > "$CONFIG.tmp" && mv "$CONFIG.tmp" "$CONFIG"
  else
    printf '%s=%s\n' "$chave" "$valor" >> "$CONFIG"
  fi
  echo "$rotulo: $valor"
}

# NVO_AGENT_CMD existe para testes (ex.: "bash"); em uso real e sempre claude,
# SEM --dangerously-skip-permissions (regra 2 do SPEC).
AGENT_CMD="${NVO_AGENT_CMD:-claude}"

HARNESSES="$ORQ/bin/harnesses.conf"

# Campo N da linha do harness, ou vazio se o harness nao existe no registro.
harness_field() {
  local id="$1" n="$2"
  [ -f "$HARNESSES" ] || return 0
  awk -F'|' -v id="$id" -v n="$n" \
    '/^[[:space:]]*#/ {next} NF>=7 && $1==id {print $n; exit}' "$HARNESSES"
}

harness_exists() { [ -n "$(harness_field "$1" 1)" ]; }

# Monta a linha de comando do harness ja com o modelo aplicado.
harness_launch() {
  local id="$1" model="$2" tpl
  if [ -n "$model" ]; then
    tpl="$(harness_field "$id" 4)"
    tpl="${tpl//%M%/$model}"
  else
    tpl="$(harness_field "$id" 5)"
  fi
  printf '%s' "$tpl"
}

# Lista os harnesses em formato estavel para o app consumir:
#   id \t rotulo \t instalado(0|1) \t modelos \t como instalar
cmd_harnesses() {
  [ -f "$HARNESSES" ] || die "registro de harnesses nao encontrado: $HARNESSES"
  local id label bin models install
  while IFS='|' read -r id label bin _ _ models install; do
    case "$id" in ''|\#*) continue ;; esac
    if command -v "$bin" >/dev/null 2>&1; then
      printf '%s\t%s\t1\t%s\t%s\n' "$id" "$label" "$models" "$install"
    else
      printf '%s\t%s\t0\t%s\t%s\n' "$id" "$label" "$models" "$install"
    fi
  done < "$HARNESSES"
}

die() { echo "nvo: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
nvo — orquestrador local de agentes Claude Code

  nvo init <caminho-do-repo>   registra o projeto ativo
  nvo maestro [harness] [modelo]
                               inicia o maestro no projeto, com briefing
                               (ex.: nvo maestro claude opus)
  nvo new [--plan] <nome> "<tarefa>" [claude|codex] [modelo]
                               cria branch+worktree e inicia o agente no tmux
                               --plan: agente planeja e espera aprovacao
  nvo approve <nome>           aprova o plano de um agente em espera
  nvo ls                       lista agentes, branch, status e ultimas linhas
  nvo read <nome> [n]          le a tela do agente sem interromper (padrao 40)
  nvo send <nome> "<texto>"    envia um prompt ao agente
  nvo note <nome>              imprime as notas do agente
  nvo diff <nome>              diff da branch do agente contra a base
  nvo explain <nome>           explica o diff em portugues simples (harness barato)
  nvo done <nome>              mostra diff, pede confirmacao, faz merge --no-ff
  nvo kill <nome>              encerra janela e remove worktree SEM merge
  nvo attach                   entra na sessao tmux "orquestra"
  nvo stop [--forget-project]  encerra a sessao (maestro e agentes) preservando
                               worktrees, branches, notas e o projeto ativo
  nvo harnesses                lista as CLIs de agente e quais estao instaladas
  nvo config [<chave> <valor>] le ou ajusta os limites da equipe
                               (max_depth, max_fanout, max_agents)
  nvo doctor                   diagnostica o ambiente (deps, login, hook)
  nvo usage [--json]           consumo de tokens: sessao 5h, dia, modelos
EOF
}

load_project() {
  [ -f "$CONF" ] || die "nenhum projeto ativo. Rode: nvo init <caminho-do-repo>"
  REPO="$(cat "$CONF")"
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 \
    || die "projeto registrado nao e mais um repo git: $REPO"
  PROJ="$(basename "$REPO")"
}

check_name() {
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_-]+$' \
    || die "nome invalido '$1' (use apenas letras, numeros, - e _)"
}

wt_path()   { echo "$WT_ROOT/$PROJ/$1"; }
meta_path() { echo "$META_ROOT/$PROJ/$1"; }
note_path() { echo "$NOTES_ROOT/$PROJ/$1.md"; }

# Regra 7 do SPEC: worktree fora de ~/orquestra/worktrees e recusado.
assert_wt_inside() {
  case "$1" in
    "$WT_ROOT"/*) ;;
    *) die "worktree fora de $WT_ROOT e recusado: $1" ;;
  esac
}

ensure_session() {
  tmux has-session -t "$SESSION" 2>/dev/null \
    || tmux new-session -d -s "$SESSION" -n maestro -c "$ORQ"
  # um servidor tmux que subiu com PATH pobre (ex.: criado pelo app) continuaria
  # sem enxergar o claude nas janelas novas — reescrevemos o PATH do ambiente
  # global a cada chamada, que e barato e mantem as janelas futuras sadias.
  tmux set-environment -g PATH "$PATH" 2>/dev/null || true
}

# instala o hook de seguranca num diretorio de trabalho, sem sujar o git do
# usuario (settings.local.json + .git/info/exclude)
install_guard_local() {
  local d="$1" gitdir ex
  mkdir -p "$d/.claude"
  cp "$ORQ/.claude/settings.json" "$d/.claude/settings.local.json" 2>/dev/null || return 0
  # --git-common-dir pode voltar caminho RELATIVO (ex.: ".git"); quando o nvo
  # e chamado pelo app o cwd e "/" e um mkdir relativo estoura em sistema
  # somente leitura — por isso ancoramos no diretorio do projeto
  gitdir="$(git -C "$d" rev-parse --git-common-dir 2>/dev/null)" || return 0
  [ -n "$gitdir" ] || return 0
  case "$gitdir" in /*) ;; *) gitdir="$d/$gitdir" ;; esac
  ex="$gitdir/info/exclude"
  mkdir -p "$gitdir/info" 2>/dev/null || return 0
  grep -q 'claude/settings.local.json' "$ex" 2>/dev/null \
    || printf '\n# orquestra (local, nao versionar)\n.claude/settings.local.json\n' >> "$ex"
}

agent_exists() { [ -d "$(wt_path "$1")" ]; }

cmd_init() {
  [ $# -eq 1 ] || die "uso: nvo init <caminho-do-repo>"
  local repo
  repo="$(cd "$1" 2>/dev/null && pwd)" || die "diretorio nao existe: $1"
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 \
    || die "nao e um repositorio git: $repo"
  echo "$repo" > "$CONF"
  echo "projeto ativo: $(basename "$repo") ($repo)"
}

cmd_new() {
  # --plan em qualquer posicao: agente planeja e espera aprovacao antes de codar
  # --parent <nome>: o agente nasce como subagente de outro, criando camadas
  local plan=0 parent="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --plan) plan=1; shift ;;
      --parent) [ $# -ge 2 ] || die "uso: --parent <nome>"; parent="$2"; shift 2 ;;
      --parent=*) parent="${1#--parent=}"; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  set -- ${args[@]+"${args[@]}"}

  [ $# -ge 2 ] || die 'uso: nvo new [--plan] [--parent <nome>] <nome> "<tarefa>" [claude|codex] [modelo]'
  local name="$1" task="$2" cli="${3:-$AGENT_CMD}" model="${4:-}"
  # o harness vem do registro (bin/harnesses.conf); "bash" fica de fora dele
  # de proposito, e so para teste
  local hbin hinstall
  if [ "$cli" = "bash" ]; then
    hbin="bash"
  else
    harness_exists "$cli" || die \
      "harness '$cli' desconhecido. Disponiveis: $(cmd_harnesses | cut -f1 | tr '\n' ' ')"
    hbin="$(harness_field "$cli" 3)"
    hinstall="$(harness_field "$cli" 7)"
  fi
  [ -z "$model" ] || printf '%s' "$model" | grep -Eq '^[A-Za-z0-9._/-]+$' \
    || die "modelo invalido '$model'"
  command -v "$hbin" >/dev/null 2>&1 || die \
    "'$hbin' nao esta instalado (harness $cli).${hinstall:+ Para instalar: $hinstall}"
  check_name "$name"
  load_project

  # --- hierarquia: valida profundidade, fanout e total antes de gastar nada ---
  local depth=1 filhos=0 vivos=0
  if [ -n "$parent" ]; then
    check_name "$parent"
    agent_exists "$parent" || die "agente pai '$parent' nao existe"
    local pmeta pdepth
    pmeta="$(meta_path "$parent").meta"
    pdepth="$(sed -n 's/^depth=//p' "$pmeta" 2>/dev/null)"
    [ -n "$pdepth" ] || pdepth=1
    depth=$((pdepth + 1))
    [ "$depth" -le "$NVO_MAX_DEPTH" ] || die \
      "profundidade $depth excede o limite de $NVO_MAX_DEPTH: '$parent' ja esta na ultima camada que pode delegar. Peca a ele para fazer a tarefa, ou crie o agente direto no maestro."
    # grep sem resultado sai com 1 e o pipefail derrubaria o script inteiro
    filhos="$(grep -l "^parent=$parent$" "$META_ROOT/$PROJ"/*.meta 2>/dev/null | wc -l | tr -d ' ' || true)"
    [ -n "$filhos" ] || filhos=0
    [ "$filhos" -lt "$NVO_MAX_FANOUT" ] || die \
      "'$parent' ja tem $filhos subagentes (limite $NVO_MAX_FANOUT). Espere um terminar, ou junte as tarefas."
  fi
  vivos="$(ls -1 "$META_ROOT/$PROJ"/*.meta 2>/dev/null | wc -l | tr -d ' ' || true)"
  [ -n "$vivos" ] || vivos=0
  [ "$vivos" -lt "$NVO_MAX_AGENTS" ] || die \
    "ja existem $vivos agentes ativos (limite $NVO_MAX_AGENTS). Aprove ou descarte alguem antes de criar outro."

  local wt base branch note meta
  wt="$(wt_path "$name")"
  assert_wt_inside "$wt"
  agent_exists "$name" && die "agente '$name' ja existe"
  branch="agent/$name"
  git -C "$REPO" show-ref --verify --quiet "refs/heads/$branch" \
    && die "branch $branch ja existe; escolha outro nome ou apague-a"

  base="$(git -C "$REPO" symbolic-ref --short HEAD)" \
    || die "repo esta em detached HEAD; faca checkout de uma branch primeiro"
  [ "$base" = "main" ] || [ "$base" = "master" ] || true  # base pode ser qualquer branch

  mkdir -p "$WT_ROOT/$PROJ" "$NOTES_ROOT/$PROJ" "$META_ROOT/$PROJ"
  git -C "$REPO" worktree add -b "$branch" "$wt" "$base" >/dev/null

  meta="$(meta_path "$name")"
  printf 'base=%s\ncli=%s\nmodel=%s\nparent=%s\ndepth=%s\n' \
    "$base" "$cli" "$model" "$parent" "$depth" > "$meta.meta"

  note="$(note_path "$name")"
  [ -f "$note" ] || printf '# %s — %s\n\n' "$PROJ" "$name" > "$note"

  # o agente carrega o guard junto, sem sujar o diff da branch
  install_guard_local "$wt"

  # Prompt inicial via arquivo para evitar inferno de aspas no send-keys
  {
    printf 'Tarefa: %s\n\n' "$task"
    if [ "$plan" = 1 ]; then
      cat <<EOF
PRIMEIRA ETAPA — PLANO, SEM ESCREVER CODIGO:
Investigue o que for necessario para entender a tarefa, e escreva em $note:
  1. o que voce entendeu que precisa ser feito
  2. os arquivos que pretende criar ou alterar
  3. os passos, em ordem
  4. riscos, e o que voce explicitamente NAO vai fazer
Depois escreva a linha "STATUS: AGUARDANDO APROVACAO" e PARE.
Nao implemente nada nesta etapa. Alguem vai revisar o plano e aprovar.
Quando receber a aprovacao, execute o plano que voce escreveu.

EOF
    fi
    cat <<EOF
Contexto e regras obrigatorias:
- Voce esta em um git worktree isolado, na branch $branch. Trabalhe somente aqui.
- Nao troque de branch, nao toque em main/master, nao faca git push.
- Faca commits pequenos e frequentes na sua branch.
- Escopo: entregue exatamente o que foi pedido, no tamanho que foi pedido. Nao
  adicione features, refatoracoes, abstracoes, nem tratamento de erro para
  cenarios que nao podem acontecer. Nao invente requisitos futuros.
- Duvida que muda o resultado do trabalho: NAO adivinhe. Escreva a pergunta em
  $note numa linha comecando com "BLOQUEADO:" e pare. Alguem responde e voce
  continua de onde parou. Decisoes pequenas (nome de variavel, ordem dos
  arquivos, formatacao) resolva voce mesmo e apenas registre nas notas.
- Ao fim de cada etapa, registre progresso e decisoes em $note (secoes com
  data/hora). O orquestrador le essas notas em vez de ler sua tela.
- Ao terminar a tarefa, escreva "STATUS: CONCLUIDO" na ultima secao das notas.
EOF
    # Delegacao: so quem ainda tem camada abaixo recebe a ferramenta. Quem esta
    # no ultimo nivel precisa saber disso, senao tenta, falha e desperdica turno.
    if [ "$depth" -lt "$NVO_MAX_DEPTH" ]; then
      cat <<EOF

DELEGACAO (voce e o agente "$name", camada $depth de $NVO_MAX_DEPTH):
Se a tarefa for grande demais para uma cabeca so, voce pode criar subagentes:
  nvo new --parent $name <nome> "<tarefa>" claude sonnet
Cada um recebe o proprio worktree e a propria branch, isolado do seu.
  nvo ls                  ve o estado de todos
  nvo note <nome>         le as notas de um subagente seu
  nvo send <nome> "..."   corrige o rumo de um subagente seu

Quando delegar vale a pena:
- as partes sao independentes e cabem em arquivos ou modulos diferentes;
- a tarefa tem duas naturezas distintas (ex.: implementar e revisar).
Quando NAO vale:
- a tarefa e pequena, ou voce ja entendeu como fazer: delegar custa mais token
  do que fazer, porque o subagente precisa reaprender todo o contexto;
- as partes mexem no mesmo arquivo: vira conflito de merge garantido.

Limites: no maximo $NVO_MAX_FANOUT subagentes seus e $NVO_MAX_AGENTS agentes vivos no projeto
inteiro. Voce NAO aprova nem descarta o trabalho de ninguem — isso e do humano.
Quando um subagente seu concluir, integre o resultado ao seu relatorio e diga
nas suas notas que o trabalho dele esta pronto para revisao.
EOF
    else
      cat <<EOF

VOCE E O ULTIMO NIVEL (camada $depth de $NVO_MAX_DEPTH): nao crie subagentes, o
"nvo new" vai recusar. Execute a tarefa voce mesmo. Se ela for grande demais,
escreva "BLOQUEADO:" nas notas explicando como dividiria, e pare.
EOF
    fi
    printf '\nComece agora.\n'
  } > "$meta.prompt"

  ensure_session
  tmux new-window -t "$SESSION" -n "$name" -c "$wt"
  local launch
  if [ "$cli" = "bash" ]; then
    launch="bash"
  else
    launch="$(harness_launch "$cli" "$model")"
    [ -n "$launch" ] || die "nao consegui montar o comando do harness '$cli'"
  fi
  tmux send-keys -t "$SESSION:$name" "$launch \"\$(cat '$meta.prompt')\"" Enter

  echo "agente '$name' criado ($cli${model:+ · $model})"
  if [ -n "$parent" ]; then
    echo "  subagente de '$parent' (camada $depth de $NVO_MAX_DEPTH)"
  fi
  echo "  branch:   $branch (base: $base)"
  echo "  worktree: $wt"
  echo "  notas:    $note"
  echo "  tela:     nvo read $name  |  ao vivo: nvo attach"
}

# status derivado das notas do agente — o marcador que aparece por ultimo manda
agent_status() {
  local note last
  note="$(note_path "$1")"
  [ -f "$note" ] || { echo trabalhando; return; }
  last="$(tail -c 4000 "$note" \
    | grep -oiE 'STATUS:[[:space:]]*CONCLU|STATUS:[[:space:]]*AGUARDANDO|BLOQUEADO|BLOQUEIO:' \
    | tail -1 | tr '[:lower:]' '[:upper:]')"
  case "$last" in
    *CONCLU*)     echo concluido ;;
    *AGUARDANDO*) echo aguardando ;;
    *BLOQUE*)     echo bloqueado ;;
    *)            echo trabalhando ;;
  esac
}

cmd_maestro() {
  # nvo maestro [harness] [modelo] — o orquestrador tambem tem dono de modelo:
  # quem paga a conta escolhe o cerebro do chefe; os workers ele dosa sozinho.
  local mcli="${1:-claude}" mmodel="${2:-}"
  harness_exists "$mcli" || die \
    "harness '$mcli' desconhecido. Disponiveis: $(cmd_harnesses | cut -f1 | tr '\n' ' ')"
  local mbin; mbin="$(harness_field "$mcli" 3)"
  command -v "$mbin" >/dev/null 2>&1 || die \
    "'$mbin' nao esta instalado (harness $mcli). $(harness_field "$mcli" 7)"
  [ -z "$mmodel" ] || printf '%s' "$mmodel" | grep -Eq '^[A-Za-z0-9._/-]+$' \
    || die "modelo invalido '$mmodel'"
  local mlaunch; mlaunch="$(harness_launch "$mcli" "$mmodel")"

  load_project
  ensure_session
  local brief="$META_ROOT/$PROJ.maestro.txt"
  mkdir -p "$META_ROOT"
  # o maestro tambem roda com o guard, no diretorio do projeto
  install_guard_local "$REPO"
  # o briefing lista so os harnesses INSTALADOS: o maestro escolhe entre o que
  # existe de fato na maquina, em vez de chutar e ver o comando falhar
  local harness_list
  harness_list="$(cmd_harnesses | awk -F'\t' '$3==1 {printf "  %s — modelos: %s\n", $1, $4}')"
  [ -n "$harness_list" ] || harness_list="  claude"
  cat > "$brief" <<EOF
Voce e o MAESTRO do orquestra: um orquestrador de agentes de codigo.

Projeto ativo: $REPO
Voce esta rodando dentro dessa pasta.

SEU PAPEL: voce NAO escreve nem edita o codigo do projeto. Voce delega para
agentes e acompanha o trabalho deles. Quem constroi sao eles, cada um numa
copia isolada do projeto (git worktree + branch propria).

A EQUIPE TEM CAMADAS: voce e a camada 0. Os agentes que voce cria sao a camada
1, e eles proprios podem criar subagentes (camada 2) quando a tarefa render
divisao. O limite e $NVO_MAX_DEPTH camadas, $NVO_MAX_FANOUT filhos por agente e $NVO_MAX_AGENTS agentes vivos.
Prefira delegar em profundidade so quando a tarefa tem partes independentes de
verdade: cada camada custa contexto e afasta o trabalho de quem pediu.

HARNESSES DISPONIVEIS NESTA MAQUINA (a CLI que roda cada agente):
$harness_list
Escolha por tarefa. So use os listados acima — outros nao estao instalados e
o comando falha.

SUAS FERRAMENTAS (rode pelo Bash):
  nvo new [--plan] [--parent <nome>] <nome> "<tarefa>" [harness] [modelo]
        cria um agente. Use --plan quando a tarefa for grande ou ambigua: o
        agente escreve um plano e espera aprovacao antes de escrever codigo.
        Modelo: use "sonnet" para construcao (bem mais barato) e reserve o
        opus para revisao critica. Ex:
          nvo new builder "implementa X conforme docs/x.md" claude sonnet
          nvo new --plan refactor "reorganiza o modulo Y" claude opus
  nvo ls                     status de todos os agentes
  nvo note <nome>            le as notas de progresso de um agente
  nvo read <nome> [n]        espia a tela de um agente
  nvo send <nome> "<texto>"  manda instrucao para um agente
  nvo approve <nome>         aprova o plano de um agente que esta aguardando
  nvo diff <nome>            mostra o codigo que o agente escreveu

COMO TRABALHAR BEM:
- Prefira "nvo note" a "nvo read": as notas sao o protocolo oficial e custam
  muito menos contexto que raspar a tela.
- Escreva tarefas fechadas e verificaveis: diga o arquivo, o critério de
  pronto, e o que NAO fazer. Tarefa vaga faz o agente gastar token errado.
- Divida o trabalho por fronteira de arquivo ou modulo: dois agentes no mesmo
  arquivo geram conflito de merge.
- Comece com 2 agentes (ex: um builder e um reviewer), nao com 6.

O QUE VOCE NAO FAZ:
- Nao roda "nvo done", "nvo kill" nem "git push". Aprovar e descartar sao
  decisoes do humano. Quando um agente concluir, avise o humano e diga para
  ele revisar com "nvo diff <nome>" e aprovar com "nvo done <nome>".
- Nao edita arquivos do projeto voce mesmo, mesmo que pareca mais rapido.

QUADRO DE STATUS (obrigatorio):
- Mantenha o arquivo $NOTES_ROOT/$PROJ/_quadro.md como um quadro para o
  humano, em linguagem SIMPLES e curta — zero jargao tecnico. Estrutura:
    ## O que a equipe ja fez
    ## O que mudou no projeto (em palavras, nao em diff)
    ## Em andamento agora
    ## Esperando decisao sua
- Atualize o quadro: ao criar agentes, quando um agente concluir ou
  bloquear, quando voce integrar algo, e ao final do trabalho. Ele aparece
  como um cartao no painel do humano — e a janela dele para o que esta
  acontecendo.

INTEGRACAO (merge) — regra de autorizacao:
- Por padrao, quem aprova e o humano (nvo done). Voce so pode integrar o
  trabalho de um agente voce mesmo se o humano disser EXPLICITAMENTE na
  conversa (ex.: "pode aprovar", "integra ai", "faz o merge"). Nesse caso:
    1. revise o diff do agente (nvo diff <nome>)
    2. integre com: nvo done <nome> --confirm <nome>
    3. registre no quadro O QUE foi integrado e por que
- Autorizacao vale para o pedido em que ela foi dada, nao para sempre.

Agora responda apenas "pronto" e aguarde as instrucoes do humano.
EOF
  tmux send-keys -t "$SESSION:maestro" \
    "cd '$REPO' && $mlaunch \"\$(cat '$brief')\"" Enter
  echo "maestro iniciado em $REPO ($mcli${mmodel:+ · $mmodel})"
  echo "  acompanhe no app, ou entre com: nvo attach"
}

cmd_approve() {
  [ $# -eq 1 ] || die "uso: nvo approve <nome>"
  load_project
  agent_exists "$1" || die "agente '$1' nao existe"
  echo "== plano de '$1':"
  cmd_note "$1"
  echo
  cmd_send "$1" "Plano aprovado. Execute o plano que voce registrou nas notas. Se surgir duvida que mude o resultado, pare e escreva BLOQUEADO: <pergunta> nas notas."
  echo "plano aprovado — '$1' voltou a trabalhar"
}

cmd_ls() {
  load_project
  local dir name branch changes lines st badge
  local n_done=0 n_wait=0 n_block=0 n_work=0 found=0
  [ -d "$WT_ROOT/$PROJ" ] || { echo "nenhum agente ativo em $PROJ"; return 0; }
  for dir in "$WT_ROOT/$PROJ"/*/; do
    [ -d "$dir" ] || continue
    found=1
    name="$(basename "$dir")"
    branch="$(git -C "$dir" branch --show-current 2>/dev/null || echo '?')"
    changes="$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    st="$(agent_status "$name")"
    case "$st" in
      concluido)   badge=$'\033[32m● CONCLUIDO\033[0m';         n_done=$((n_done+1)) ;;
      aguardando)  badge=$'\033[36m● PLANO AGUARDANDO\033[0m';  n_wait=$((n_wait+1)) ;;
      bloqueado)   badge=$'\033[31m● BLOQUEADO\033[0m';         n_block=$((n_block+1)) ;;
      *)           badge=$'\033[2m● trabalhando\033[0m';        n_work=$((n_work+1)) ;;
    esac
    printf '== %s  %s  [%s, %s arq. alterados]\n' "$name" "$badge" "$branch" "$changes"
    lines="$(tmux capture-pane -pt "$SESSION:$name" 2>/dev/null \
      | grep -v '^[[:space:]]*$' | tail -3 || true)"
    if [ -n "$lines" ]; then
      printf '%s\n' "$lines" | sed 's/^/   | /'
    else
      echo "   | (sem janela tmux ativa)"
    fi
    echo
  done
  if [ "$found" -eq 0 ]; then
    echo "nenhum agente ativo em $PROJ"
    return 0
  fi
  printf 'resumo: %s concluido(s), %s plano(s) aguardando, %s bloqueado(s), %s trabalhando\n' \
    "$n_done" "$n_wait" "$n_block" "$n_work"
  [ "$n_done" -gt 0 ] && echo "  → revise: nvo diff <nome>   aprove: nvo done <nome>"
  [ "$n_wait" -gt 0 ] && echo "  → leia o plano: nvo note <nome>   libere: nvo approve <nome>"
  [ "$n_block" -gt 0 ] && echo "  → destrave: nvo note <nome>   responda: nvo send <nome> \"...\""
  return 0
}

cmd_read() {
  [ $# -ge 1 ] || die "uso: nvo read <nome> [n]"
  load_project
  local name="$1" n="${2:-40}"
  agent_exists "$name" || die "agente '$name' nao existe"
  tmux capture-pane -pt "$SESSION:$name" -S -1000 2>/dev/null | tail -n "$n" \
    || die "janela tmux do agente '$name' nao encontrada"
}

cmd_send() {
  [ $# -eq 2 ] || die 'uso: nvo send <nome> "<texto>"'
  load_project
  local name="$1" text="$2"
  agent_exists "$name" || die "agente '$name' nao existe"
  tmux send-keys -t "$SESSION:$name" -l "$text"
  sleep 0.3
  tmux send-keys -t "$SESSION:$name" Enter
  echo "enviado para '$name'"
}

cmd_note() {
  [ $# -eq 1 ] || die "uso: nvo note <nome>"
  load_project
  local note; note="$(note_path "$1")"
  [ -f "$note" ] || die "sem notas para '$1' ($note)"
  cat "$note"
}

get_base() {
  local meta; meta="$(meta_path "$1").meta"
  [ -f "$meta" ] || die "metadados do agente '$1' nao encontrados"
  sed -n 's/^base=//p' "$meta"
}

cmd_diff() {
  [ $# -eq 1 ] || die "uso: nvo diff <nome>"
  load_project
  local name="$1" wt base mb behind
  agent_exists "$name" || die "agente '$name' nao existe"
  wt="$(wt_path "$name")"
  base="$(get_base "$name")"
  echo "== commits de agent/$name desde $base:"
  git -C "$wt" log --oneline "$base..HEAD" || true
  echo
  # avisa se a base avancou desde que o agente nasceu, para o humano saber
  # que pode haver conflito e que o diff abaixo ja ignora esses commits
  mb="$(git -C "$wt" merge-base "$base" HEAD)"
  behind="$(git -C "$wt" rev-list --count "$mb..$base")"
  if [ "$behind" -gt 0 ]; then
    echo "aviso: a base '$base' andou $behind commit(s) desde que este agente comecou"
    echo
  fi
  # diff a partir do ponto de partida comum (merge-base), nao da ponta atual
  # da base, senao commits novos da base aparecem como se o agente os tivesse
  # apagado. A forma "base..." (tres pontos, sem lado direito) compara contra
  # merge-base e ainda inclui mudancas nao commitadas no worktree.
  git -C "$wt" diff "$base"...
}

# Escolhe harness+modelo baratos para "nvo explain": prefere claude com o
# modelo haiku (se ambos estiverem no registro e instalados); senao cai para
# o primeiro harness instalado, usando o ultimo modelo da lista dele —
# convencao do harnesses.conf, onde o modelo mais leve vem por ultimo.
# Imprime "binario<TAB>modelo" e retorna 1 se nada estiver instalado.
pick_explain_harness() {
  [ -f "$HARNESSES" ] || return 1
  local hbin models
  hbin="$(harness_field claude 3)"
  models="$(harness_field claude 6)"
  if [ -n "$hbin" ] && command -v "$hbin" >/dev/null 2>&1; then
    case ",$models," in
      *,haiku,*) printf '%s\t%s\n' "$hbin" "haiku"; return 0 ;;
    esac
  fi
  local xid xbin xmodels model
  while IFS='|' read -r xid _ xbin _ _ xmodels _; do
    case "$xid" in ''|\#*) continue ;; esac
    if command -v "$xbin" >/dev/null 2>&1; then
      model="$(printf '%s' "$xmodels" | awk -F',' '{print $NF}')"
      printf '%s\t%s\n' "$xbin" "$model"
      return 0
    fi
  done < "$HARNESSES"
  return 1
}

cmd_explain() {
  [ $# -eq 1 ] || die "uso: nvo explain <nome>"
  load_project
  local name="$1" wt base note diff_text notes_text
  agent_exists "$name" || die "agente '$name' nao existe"
  wt="$(wt_path "$name")"
  base="$(get_base "$name")"
  note="$(note_path "$name")"

  diff_text="$(git -C "$wt" diff "$base"...)"
  [ -n "$diff_text" ] || die "sem diff: agente '$name' nao tem mudancas contra $base"

  notes_text=""
  [ -f "$note" ] && notes_text="$(cat "$note")"

  # trunca o diff para nao gastar token a toa com harness caro
  local max_chars=12000 truncated=0
  if [ "${#diff_text}" -gt "$max_chars" ]; then
    diff_text="${diff_text:0:$max_chars}"
    truncated=1
  fi

  local pick hbin model
  pick="$(pick_explain_harness)" \
    || die "nenhum harness instalado para 'nvo explain' (veja bin/harnesses.conf)"
  hbin="$(printf '%s' "$pick" | cut -f1)"
  model="$(printf '%s' "$pick" | cut -f2)"

  [ "$truncated" -eq 1 ] \
    && echo "nvo: diff grande, truncado para $max_chars caracteres antes de enviar ao modelo"

  local prompt
  prompt="$(cat <<EOF
Voce explica para um humano nao-tecnico o que um agente de codigo mudou.
Responda em portugues simples, entre 6 e 10 linhas, texto corrido sem
markdown pesado (sem titulos, sem blocos de codigo). Cubra, nesta ordem:
1) o que mudou e em quais arquivos; 2) o risco de aplicar essa mudanca;
3) o que vale testar a mao depois de aplicar; 4) o que as notas do agente
prometem mas nao aparece no diff (se nada faltar, diga isso).

=== NOTAS DO AGENTE ===
${notes_text:-(sem notas)}

=== DIFF (base...agente, pode estar truncado) ===
$diff_text
EOF
)"

  local output rc
  output="$(printf '%s' "$prompt" | "$hbin" --model "$model" -p 2>&1)"
  rc=$?
  [ $rc -eq 0 ] && [ -n "$output" ] \
    || die "chamada ao harness '$hbin' (modelo $model) falhou; nao foi possivel gerar a explicacao"
  echo "$output"
}

cmd_done() {
  local name="" confirm="" have_confirm=0
  while [ $# -gt 0 ]; do
    case "$1" in
      # A confirmacao pode vir por argumento para que uma interface grafica
      # colete o nome digitado. A regra 6 continua de pe: sem o nome exato
      # nao ha merge — o que muda e onde o humano digita, nao se ele digita.
      --confirm) [ $# -ge 2 ] || die "uso: nvo done <nome> --confirm <nome>"
                 confirm="$2"; have_confirm=1; shift 2 ;;
      --confirm=*) confirm="${1#--confirm=}"; have_confirm=1; shift ;;
      -*) die "opcao desconhecida: $1" ;;
      *)  [ -z "$name" ] || die "uso: nvo done <nome> [--confirm <nome>]"
          name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "uso: nvo done <nome> [--confirm <nome>]"
  load_project
  local wt base branch
  agent_exists "$name" || die "agente '$name' nao existe"
  wt="$(wt_path "$name")"
  assert_wt_inside "$wt"
  base="$(get_base "$name")"
  branch="agent/$name"

  [ -z "$(git -C "$wt" status --porcelain)" ] \
    || die "o worktree de '$name' tem mudancas nao commitadas; peca ao agente para commitar (nvo send $name \"commite seu trabalho\")"

  echo "== diff de $branch contra $base:"
  git -C "$REPO" diff "$base...$branch" || true
  echo
  git -C "$REPO" log --oneline "$base..$branch" || true
  echo

  # Regra 6: merge nunca e automatico. Confirmacao humana digitando o nome.
  if [ "$have_confirm" -eq 0 ]; then
    printf 'Digite o nome do agente (%s) para confirmar o merge, ou qualquer outra coisa para cancelar: ' "$name"
    IFS= read -r confirm
  fi
  [ "$confirm" = "$name" ] || die "confirmacao nao confere; merge cancelado"

  [ "$(git -C "$REPO" symbolic-ref --short HEAD)" = "$base" ] \
    || die "o repo principal nao esta na branch base '$base'; faca checkout dela antes"
  [ -z "$(git -C "$REPO" status --porcelain)" ] \
    || die "o repo principal tem mudancas nao commitadas; resolva antes do merge"

  git -C "$REPO" merge --no-ff "$branch" -m "merge $branch"
  git -C "$REPO" worktree remove "$wt"
  git -C "$REPO" branch -d "$branch"
  tmux kill-window -t "$SESSION:$name" 2>/dev/null || true
  rm -f "$(meta_path "$name").meta" "$(meta_path "$name").prompt"
  echo "merge de $branch concluido; worktree removido. Notas preservadas em $(note_path "$name")"
}

# Encerra a sessao inteira: derruba maestro e agentes, mas NAO toca em worktree,
# branch nem notas. E um "fechar o expediente" — o trabalho continua no disco e
# volta a aparecer quando os agentes forem religados.
cmd_stop() {
  # O projeto continua registrado por padrao: encerrar a sessao e algo que se
  # faz varias vezes por dia, e perder o projeto ativo nisso obriga a reconfigurar
  # do zero. Desregistrar e o caso raro, entao exige a flag.
  local forget=0
  case "${1:-}" in
    --forget-project) forget=1 ;;
    --keep-project|"") ;;
    *) die "uso: nvo stop [--forget-project]" ;;
  esac
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION"
    echo "sessao '$SESSION' encerrada (maestro e agentes desligados)"
  else
    echo "nenhuma sessao ativa"
  fi
  if [ "$forget" -eq 1 ] && [ -f "$CONF" ]; then
    rm -f "$CONF"
    echo "projeto ativo desregistrado — use 'nvo init <caminho>' para comecar outro"
  fi
  echo "worktrees, branches e notas foram preservados"
}

cmd_kill() {
  [ $# -eq 1 ] || die "uso: nvo kill <nome>"
  load_project
  local name="$1" wt
  agent_exists "$name" || die "agente '$name' nao existe"
  wt="$(wt_path "$name")"
  assert_wt_inside "$wt"
  tmux kill-window -t "$SESSION:$name" 2>/dev/null || true
  git -C "$REPO" worktree remove --force "$wt"
  rm -f "$(meta_path "$name").meta" "$(meta_path "$name").prompt"
  echo "agente '$name' encerrado SEM merge. A branch agent/$name foi preservada;"
  echo "para descartar de vez: git -C $REPO branch -D agent/$name"
}

cmd_attach() {
  ensure_session
  exec tmux attach -t "$SESSION"
}

cmd_doctor() {
  local ok=0 warn=0 fail=0
  chk() { # chk <status:OK|AVISO|FALTA> <mensagem> [dica]
    case "$1" in
      OK)    ok=$((ok+1));   printf '  \033[32m✓\033[0m %s\n' "$2" ;;
      AVISO) warn=$((warn+1)); printf '  \033[33m!\033[0m %s\n' "$2"; [ "${3:-}" ] && printf '      → %s\n' "$3" ;;
      FALTA) fail=$((fail+1)); printf '  \033[31m✗\033[0m %s\n' "$2"; [ "${3:-}" ] && printf '      → %s\n' "$3" ;;
    esac
  }
  echo "nvo doctor — diagnostico do ambiente"
  echo

  case "$ORQ_OS" in
    macos) chk OK "plataforma: macOS $(sw_vers -productVersion 2>/dev/null)" ;;
    wsl)   chk OK "plataforma: Windows via WSL2 (${WSL_DISTRO_NAME:-linux})" ;;
    linux) chk OK "plataforma: Linux" ;;
    *)     chk AVISO "plataforma nao reconhecida ($(uname -s))" "o orquestra e testado em macOS, Linux e WSL2" ;;
  esac

  command -v tmux >/dev/null 2>&1 \
    && chk OK "tmux $(tmux -V | awk '{print $2}')" \
    || chk FALTA "tmux nao encontrado" "$(orq_pkg_hint tmux)"

  command -v jq >/dev/null 2>&1 \
    && chk OK "jq instalado" \
    || chk FALTA "jq nao encontrado" "$(orq_pkg_hint jq)"

  if command -v git >/dev/null 2>&1; then
    chk OK "git $(git --version | awk '{print $3}')"
    if [ -n "$(git config --global user.name 2>/dev/null)" ]; then
      chk OK "identidade git: $(git config --global user.name)"
    else
      chk AVISO "git sem user.name global" 'git config --global user.name "Seu Nome" && git config --global user.email voce@email.com'
    fi
  else
    [ "$ORQ_OS" = macos ] \
      && chk FALTA "git nao encontrado" "xcode-select --install" \
      || chk FALTA "git nao encontrado" "$(orq_pkg_hint git)"
  fi

  if command -v claude >/dev/null 2>&1; then
    local claude_path; claude_path="$(command -v claude)"
    case "$claude_path" in
      /mnt/[a-z]/*|*.exe)
        # WSL enxerga o PATH do Windows: um claude.exe nao entende caminhos /home
        chk FALTA "o 'claude' encontrado e o do Windows ($claude_path)" \
          "instale o Claude Code DENTRO do WSL: npm install -g @anthropic-ai/claude-code" ;;
      *)
        chk OK "Claude Code instalado ($claude_path)"
        if [ -f "$HOME/.claude.json" ] || [ -d "$HOME/.claude" ]; then
          chk OK "Claude Code ja foi usado nesta maquina (login existente sera aproveitado)"
        else
          chk AVISO "Claude Code nunca rodou aqui" "rode 'claude' uma vez para logar; o orquestra usa a mesma conta"
        fi ;;
    esac
  else
    [ "$ORQ_OS" = macos ] \
      && chk FALTA "Claude Code nao encontrado" "npm install -g @anthropic-ai/claude-code  (ou: brew install claude)" \
      || chk FALTA "Claude Code nao encontrado" "npm install -g @anthropic-ai/claude-code"
  fi

  command -v codex >/dev/null 2>&1 \
    && chk OK "Codex CLI instalado (agentes podem usar: nvo new nome \"tarefa\" codex)" \
    || chk AVISO "Codex CLI ausente (opcional — segundo harness de agente)" "npm install -g @openai/codex"

  command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1 \
    && chk OK "GitHub CLI logado (clone de repos privados funciona)" \
    || chk AVISO "GitHub CLI ausente ou deslogado (opcional)" "$(orq_pkg_hint gh) && gh auth login — necessario so para repos privados via https"

  [ -x "$ORQ/bin/guard.sh" ] \
    && chk OK "guard.sh presente e executavel" \
    || chk FALTA "guard.sh ausente ou sem permissao de execucao" "chmod +x $ORQ/bin/guard.sh"

  grep -q '"PreToolUse"' "$ORQ/.claude/settings.json" 2>/dev/null \
    && chk OK "hook de seguranca configurado (.claude/settings.json)" \
    || chk FALTA "hook de seguranca ausente" "rode ./install.sh de novo"

  case ":$PATH:" in
    *":$ORQ/bin:"*) chk OK "~/orquestra/bin no PATH" ;;
    *) chk AVISO "~/orquestra/bin fora do PATH desta sessao" "source $ORQ_SHELL_RC ou abra um terminal novo" ;;
  esac

  if [ "$ORQ_HAS_APP" = 1 ]; then
    [ -d "$HOME/Applications/Orquestra.app" ] \
      && chk OK "Orquestra.app instalado" \
      || chk AVISO "Orquestra.app nao compilado (opcional)" "bash $ORQ/app/build.sh"
  else
    chk OK "interface: CLI (o app visual e exclusivo do macOS)"
  fi

  if [ -f "$CONF" ]; then
    chk OK "projeto ativo: $(cat "$CONF")"
  else
    chk AVISO "nenhum projeto registrado ainda" "nvo init <pasta>  ou botao 'projeto' no app"
  fi

  echo
  echo "resultado: $ok ok, $warn avisos, $fail faltando"
  [ "$fail" -eq 0 ] && echo "pronto para orquestrar." || echo "resolva os itens ✗ acima antes de usar."
  [ "$fail" -eq 0 ]
}

case "${1:-}" in
  init)   shift; cmd_init "$@" ;;
  new)    shift; cmd_new "$@" ;;
  ls)     shift; cmd_ls "$@" ;;
  read)   shift; cmd_read "$@" ;;
  send)   shift; cmd_send "$@" ;;
  note)   shift; cmd_note "$@" ;;
  diff)   shift; cmd_diff "$@" ;;
  explain) shift; cmd_explain "$@" ;;
  done)   shift; cmd_done "$@" ;;
  kill)   shift; cmd_kill "$@" ;;
  attach)  shift; cmd_attach "$@" ;;
  maestro) shift; cmd_maestro "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  harnesses) shift; cmd_harnesses "$@" ;;
  config)  shift; cmd_config "$@" ;;
  approve) shift; cmd_approve "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  usage)   shift; exec python3 "$ORQ/bin/nvo-usage.py" "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "comando desconhecido: $1 (veja nvo --help)" ;;
esac
